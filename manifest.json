{
  "manifest_version": 3,
  "name": "PriceScout — Smart Buy Assistant for Amazon India",
  "version": "1.0.0",
  "description": "Buy-score, price tracking, and price-drop alerts for Amazon India — no account, no server, runs entirely in your browser.",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "permissions": ["storage", "alarms", "notifications", "offscreen"],
  "host_permissions": [
    "https://www.amazon.in/*",
    "https://www.reddit.com/*",
    "https://www.youtube.com/*"
  ],
  "background": {
    "service_worker": "background/background.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": ["https://www.amazon.in/*"],
      "js": ["content/content.js"],
      "css": ["content/overlay.css"],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_popup": "popup/popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  }
}
